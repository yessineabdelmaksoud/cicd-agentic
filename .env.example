# =============================================================================
# AI-CICD-EMBEDDED — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# --- GitLab ---
GITLAB_ROOT_PASSWORD=Admin1234!
GITLAB_EXTERNAL_URL=http://localhost
GITLAB_RUNNER_TOKEN=           # Filled after GitLab is up (see register-runner.sh)
GITLAB_PROJECT_TOKEN=          # Project-scoped API token (created in GitLab UI)
GITLAB_PROJECT_ID=1            # Set after creating the project

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_ENDPOINT=http://localhost:9000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Agent ---
AGENT_PORT=8000
# Cluster service DNS — the value actually deployed lives in
# infra/k3s/core/env-configmap.yaml; this is just for reference/host scripts.
AGENT_EXTERNAL_URL=http://agent.ai-agent.svc.cluster.local:8000
# Shared secret checked on every /webhook and /callback request (fix.md
# FIX-13) — generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
